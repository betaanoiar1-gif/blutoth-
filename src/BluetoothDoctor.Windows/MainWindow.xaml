<Window x:Class="BluetoothDoctor.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bluetooth Doctor Pro" Height="700" Width="1050" MinHeight="600" MinWidth="850" Background="#0B1020" Foreground="#F3F6FC" WindowStartupLocation="CenterScreen"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,20"><StackPanel><TextBlock Text="BLUETOOTH DOCTOR PRO" FontSize="13" FontWeight="Bold" Foreground="#8DAEFF"/><TextBlock Text="التشخيص والإصلاح الذكي" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Windows 10 / 11 · فحص محلي · لا إصلاحات خطرة دون موافقة" Foreground="#9BA8C4" Margin="0,7,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#172033" CornerRadius="12" Padding="14" VerticalAlignment="Center"><StackPanel><TextBlock Text="الحالة" Foreground="#9BA8C4"/><TextBlock x:Name="StatusText" Text="جاهز للفحص" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></DockPanel><Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#172033" CornerRadius="12" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="محول البلوتوث" Foreground="#9BA8C4"/><TextBlock x:Name="AdapterValue" Text="لم يُفحص بعد" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#172033" CornerRadius="12" Padding="18" Margin="5,0"><StackPanel><TextBlock Text="أجهزة Classic المقترنة" Foreground="#9BA8C4"/><TextBlock x:Name="ClassicValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="#172033" CornerRadius="12" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="أجهزة BLE المقترنة" Foreground="#9BA8C4"/><TextBlock x:Name="BleValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border></Grid><Border Grid.Row="2" Background="#11192B" BorderBrush="#25314B" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,14"><StackPanel><TextBlock Text="نتائج التشخيص" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="المرحلة الأولى: جرد المحول والأجهزة المقترنة" Foreground="#9BA8C4" Margin="0,5,0,0"/></StackPanel><Button x:Name="ScanButton" DockPanel.Dock="Right" Content="بدء الفحص" Click="ScanButton_Click" Padding="22,12" Background="#3478F6" Foreground="White" BorderThickness="0" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="1" x:Name="SummaryText" Text="ابدأ الفحص لجمع معلومات البلوتوث المتاحة من Windows." Foreground="#C8D2E8" TextWrapping="Wrap" Margin="0,0,0,12"/><ListBox Grid.Row="2" x:Name="FindingsList" Background="#0B1020" Foreground="#E8EEFC" BorderBrush="#25314B" Padding="8" FontSize="14"/></Grid></Border><TextBlock Grid.Row="3" Text="لا يتم تغيير إعدادات النظام في هذه النسخة الأولية." Foreground="#76839F" Margin="0,16,0,0" HorizontalAlignment="Center"/></Grid></Window>